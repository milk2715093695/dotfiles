# 私密配置：忽略本地内容，保留示例文件
/zsh/zsh/secrets/*
!/zsh/zsh/secrets/example.sh
/pwsh/pwsh/Secrets/*
!/pwsh/pwsh/Secrets/Example.ps1

# 私密配置：忽略 shell 本地覆盖配置
/zsh/zsh/locals/*
/pwsh/pwsh/Locals/*

# 可再生成资源：yazi 插件和主题
/yazi/plugins/
/yazi/flavors/

# 可再生成资源：tmux 插件，保留 tpm 管理器
/tmux/plugins/*
!/tmux/plugins/tpm/
!/tmux/plugins/tpm/**
