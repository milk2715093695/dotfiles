# 操作系统生成文件：macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# 操作系统生成文件：Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# 操作系统生成文件：Linux
.directory

# 本地工具与缓存
/Tools/
/tools/
/Cache/
/cache/
/taskbooks/
/.taskbook-backups/
/.vscode/
__pycache__/

# 代理配置与本地索引
/.claude/
/.gitnexus/
/AGENTS.md
/CLAUDE.md

# 配置渲染产物：纯文件型配置的合并输出
/generated/

# 私密配置：忽略本地内容，保留示例文件
/zsh/zsh/secrets/*
!/zsh/zsh/secrets/example.sh
/pwsh/pwsh/Secrets/*
!/pwsh/pwsh/Secrets/Example.ps1

# 私密配置：忽略 shell 本地覆盖配置
/zsh/zsh/locals/*
!/zsh/zsh/locals/.gitkeep
/pwsh/pwsh/Locals/*
!/pwsh/pwsh/Locals/.gitkeep

# 私密配置：忽略 Aerospace 本地应用规则
/aerospace/locals/*
!/aerospace/locals/.gitkeep

# 私密配置：忽略 Yazi 本地覆盖配置
/yazi/locals/*
!/yazi/locals/.gitkeep

# 私密配置：忽略 aria2 本地覆盖（rpc-secret 等凭证）
/aria2/locals/*
!/aria2/locals/.gitkeep

# 可再生成资源：yazi 插件和主题（现由 /generated/ 规则覆盖）
# /generated/ 规则已在 "配置渲染产物" 段落中

# 可再生成资源：cava shader 文件（由 cava 安装自带或首次运行生成）
/cava/common/shaders/

# 可再生成资源：tmux 插件，保留 tpm 管理器
/tmux/plugins/*
!/tmux/plugins/tpm/
!/tmux/plugins/tpm/**

# 代理本地规则：隐私（暴露使用网站），忽略全部本地内容，目录由渲染脚本创建
/pacproxy/rules/*
!/pacproxy/rules/.gitkeep

# 代理本地产物：运行日志与手动生成的 PAC
/pacproxy/pacproxy.log
/pacproxy/my_proxy.pac
/pacproxy/gfw.pac

# 代理模块构建产物：Magisk zip 与裁剪运行时，由 build.sh 生成
/pacproxy/magisk/pacproxy-tp/dist/*
!/pacproxy/magisk/pacproxy-tp/dist/.gitkeep
# pacproxy.py 单源在主仓库 (pacproxy/pacproxy.py)，模块目录不保存副本
/pacproxy/magisk/pacproxy-tp/pacproxy.py

# 模块基础规则：随模块入库（cidrs-cn 等为模块默认配置）
# 用户定制为手机端本地文件，不入仓库
/pacproxy/magisk/pacproxy-tp/user-overrides/*
!/pacproxy/magisk/pacproxy-tp/user-overrides/.gitkeep
