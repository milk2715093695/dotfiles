## CAVA configuration


[general]

live-config = 1

framerate = 60

autosens = 1

sensitivity = 100

bars = 0
bar_width = 2
bar_spacing = 1

center_align = 1

max_height = 100

lower_cutoff_freq = 50
higher_cutoff_freq = 10000

# 10秒无声音后休眠，节省后台资源
sleep_timer = 10


[input]

# PulseAudio 采集 Android 系统音频输出
method = pulse
source = auto


[output]

# Output method: 'ncurses', 'noncurses', 'raw', 'noritake', 'sdl', 'sdl_glsl'.
# noncurses = terminal buffer, less tearing than ncurses (default).
# sdl_glsl  = SDL + OpenGL shader renderer.
method = noncurses

# Bar orientation. 'bottom' = upward from bottom.
# 'horizontal' = bars grow up and down from center (noncurses only).
orientation = bottom

# 'stereo' mirrors both channels, low frequencies in center.
# 'mono' = left-to-right low-to-high frequencies.
channels = stereo
mono_option = average
reverse = 0

# SDL window settings (for sdl_glsl mode)
; sdl_width = 1024
; sdl_height = 512
; sdl_x = -1
; sdl_y = -1
; sdl_full_screen = 0

# Reduce flickering in Alacritty and some other terminals
; synchronized_sync = 0

# sdl_glsl shaders in $HOME/.config/cava/shaders
; vertex_shader = pass_through.vert
; fragment_shader = bar_spectrum.frag
; continuous_rendering = 0

show_idle_bar_heads = 0

waveform = 0


[color]

theme = 'mocha-transparent'


[smoothing]

# 比默认 77 更灵敏，低频瞬态响应跟手
noise_reduction = 60


[eq]

# V形均衡：中频保持原样，增强低频下潜和高频清晰度
1 = 1.25 # bass
2 = 1.10
3 = 1    # midtone
4 = 1.05
5 = 1.15 # treble
