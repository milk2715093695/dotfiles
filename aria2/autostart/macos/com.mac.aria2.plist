<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mac.aria2</string>
    <key>ProgramArguments</key>
    <array>
        <string>__ARIA2__</string>
        <string>--conf-path=~/.config/aria2/aria2.conf</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>~/.local/state/aria2/aria2.log</string>
    <key>StandardErrorPath</key>
    <string>~/.local/state/aria2/aria2.log</string>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
